---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="icon-circle footer-icon">
        <img src="/icon.png" alt="" width="20" height="20" />
      </span>
      <span>{site.name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>© {year} <a href="https://mudkip.me" target="_blank" rel="noopener noreferrer">{site.creator}</a></span>
    </div>

    <div class="pop-strip" aria-hidden="true">
      <i class="p-amber"></i>
      <i class="p-sky"></i>
      <i class="p-mint"></i>
      <i class="p-coral"></i>
      <i class="p-violet"></i>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 24px 0 36px;
    color: var(--ink-faint);
    font-size: 0.86rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 20px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer-icon {
    width: 20px;
    height: 20px;
  }

  .sep {
    opacity: 0.5;
  }

  .footer-brand a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 550;
  }

  .footer-brand a:hover {
    color: var(--ink);
  }

  .pop-strip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .pop-strip i {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .pop-strip .p-violet {
    width: 14px;
    border-radius: var(--radius-pill);
  }

  .p-amber { background: var(--pop-amber); }
  .p-sky { background: var(--pop-sky); }
  .p-mint { background: var(--pop-mint); }
  .p-coral { background: var(--pop-coral); }
  .p-violet { background: var(--pop-violet); }
</style>
