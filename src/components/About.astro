---
import { site } from "../data/site";
---

<section id="about" class="about-section">
  <div class="wrap about-grid">
    <div class="about-copy">
      <h2>About</h2>
      <p>
        I’m <strong>{site.creator}</strong>. I build small, open-source apps meant to run on your
        own devices and homelab servers — keeping your notes, libraries, and data in formats you
        control.
      </p>
      <p>
        Most of these started from my own hobbies: self-hosting, anime, video games, music, and
        collecting things worth remembering.
      </p>

      <a
        class="sponsor-link"
        href={site.sponsor.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="sponsor-heart" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
        <span>{site.sponsor.label}</span>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5"></path>
        </svg>
      </a>
    </div>

    <ul class="directory" aria-label="Links">
      {site.socials.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel={item.rel ? `${item.rel} noopener noreferrer` : "noopener noreferrer"}
          >
            <span class="dir-name">{item.label}</span>
            <span class="dir-handle">{item.handle}</span>
            <svg class="dir-arrow" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 11 11 5M6 5h5v5"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-section {
    padding: clamp(56px, 8vw, 92px) 0;
    border-top: 1px solid var(--line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: clamp(28px, 6vw, 64px);
    align-items: start;
  }

  .about-copy h2 {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .about-copy p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 54ch;
  }

  .about-copy p + p {
    margin-top: 12px;
  }

  .about-copy strong {
    color: var(--ink);
    font-weight: 600;
  }

  .sponsor-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding: 8px 15px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--pop-coral) 34%, var(--line));
    background: color-mix(in srgb, var(--pop-coral) 8%, transparent);
    color: var(--pop-coral);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .sponsor-link:hover {
    background: var(--pop-coral);
    border-color: var(--pop-coral);
    color: #ffffff;
  }

  :global(html.dark) .sponsor-link:hover {
    color: #0f111e;
  }

  .sponsor-link:active {
    transform: scale(0.97);
  }

  .sponsor-heart {
    flex: none;
  }

  .directory {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .directory li {
    border-bottom: 1px solid var(--line);
  }

  .directory a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 16px 4px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .dir-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dir-handle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .dir-arrow {
    color: var(--ink-faint);
    transition: transform 0.16s ease, color 0.16s ease;
  }

  .directory a:hover .dir-name {
    color: var(--pop-sky);
  }

  .directory a:hover .dir-arrow {
    color: var(--pop-sky);
    transform: translate(2px, -2px);
  }

  @media (max-width: 780px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .directory a {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .dir-handle {
      grid-column: 1 / -1;
      order: 3;
      margin-top: -6px;
    }
  }
</style>
